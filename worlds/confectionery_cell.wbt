#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/universal_robots/protos/UR5e.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/robotiq/protos/Robotiq2f85Gripper.proto"

WorldInfo {
  info [
    "Artisan Confectionery Quality Inspection and Packaging Robotic Cell"
    "Module: Integrated Robotics 4 (TUS Athlone)"
    "Universal Robots UR5e + Robotiq 2F-85 + OpenCV Vision"
  ]
  title "Artisan Confectionery Packaging Cell"
  basicTimeStep 16
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.28 -0.38 -0.88 4.2
  position -0.8 1.2 1.3
}

TexturedBackground {
}

TexturedBackgroundLight {
}

Floor {
  translation 0 0 -0.8
  size 4 4
  tileSize 1 1
}

# Main Industrial Pedestal Table (Top surface at Z = 0.0)
Solid {
  translation 0 0 -0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.4
        metalness 0.8
      }
      geometry Box {
        size 1.4 1.2 0.8
      }
    }
  ]
  name "cell_table"
  boundingObject Box {
    size 1.4 1.2 0.8
  }
}

# Infeed Inspection Pedestal
Solid {
  translation 0 0.4 0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.95
        roughness 0.2
      }
      geometry Cylinder {
        height 0.04
        radius 0.12
      }
    }
  ]
  name "infeed_pedestal"
  boundingObject Cylinder {
    height 0.04
    radius 0.12
  }
}

# 2x2 Blister Tray Presentation Fixture
Solid {
  translation 0.37 0.22 0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.88 0.92
        roughness 0.3
      }
      geometry Box {
        size 0.14 0.14 0.04
      }
    }
  ]
  name "blister_tray_fixture"
  boundingObject Box {
    size 0.14 0.14 0.04
  }
}

# Gravity Remelt Reject Chute / Scrap Bin
Solid {
  translation -0.35 0.25 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.2 0.2
        roughness 0.5
      }
      geometry Cylinder {
        height 0.10
        radius 0.08
      }
    }
  ]
  name "remelt_reject_chute"
  boundingObject Cylinder {
    height 0.10
    radius 0.08
  }
}

# Workpiece: Artisan Chocolate on Infeed Stage
Solid {
  translation 0 0.4 0.055
  rotation 0 0 1 0.785398 # 45 degrees rotation for boundary testing
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.08 0.04 # Dark chocolate
        roughness 0.3
      }
      geometry Box {
        size 0.035 0.035 0.02
      }
    }
  ]
  name "chocolate_workpiece"
  boundingObject Box {
    size 0.035 0.035 0.02
  }
  physics Physics {
    density 1300
    mass 0.025
  }
}

# Universal Robots UR5e Articulated Arm
# Note for Partner 1: In Webots, all sensors (Camera, TouchSensor) controlled by
# 'cell_supervisor' must reside inside the UR5e Robot node (e.g., in toolSlot, or
# in the base children after right-clicking UR5e -> 'Convert to Base Nodes').
UR5e {
  translation 0 0 0
  controller "cell_supervisor"
  supervisor TRUE
  toolSlot [
    Robotiq2f85Gripper {
    }
    TouchSensor {
      translation 0 0 0.14
      name "touch_sensor"
      boundingObject Sphere {
        radius 0.012
      }
      physics Physics {
        mass 0.01
      }
    }
    Camera {
      translation 0 0.05 0.05
      rotation 0 1 0 -1.5708
      name "camera"
      fieldOfView 0.65
      width 640
      height 480
    }
  ]
}
