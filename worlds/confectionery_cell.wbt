# Workpiece: Artisan Chocolate on Infeed Stage
Solid {
  translation 0 0.4 0.055
  rotation 0 0 1 0.785398 # 45 degrees rotation for boundary testing
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.08 0.04 # Dark chocolate
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.035 0.035 0.02
      }
    }
  ]
  name "chocolate_workpiece"
  boundingObject Box {
    size 0.035 0.035 0.02
  }
  physics Physics {
    density -1
    mass 0.025
  }
}

# Universal Robots UR5e Articulated Arm
# Note: In Webots, a controller can only read devices that are inside its own
# Robot node. CellUR5e (protos/CellUR5e.proto) is the official UR5e plus a
# 'baseSlot' field, so the FIXED overhead camera can sit in the robot while
# not moving with the arm. Devices that move with the gripper go in 'toolSlot'.
CellUR5e {
  translation 0 0 0
  controller "cell_supervisor"
  supervisor TRUE
  baseSlot [
    # Overhead inspection camera: fixed 0.8 m above the infeed pedestal, looking
    # straight down. Rotation makes image-right = world +X and image-up = world +Y,
    # which is what pixel_to_world_coordinates() in vision_pipeline.py assumes.
    # fieldOfView 0.4646 rad gives a ~0.35 m x 0.26 m view at the chocolate top
    # surface (z = 0.06 m), matching the default fov_width_m / fov_height_m.
    Camera {
      translation 0 0.4 0.8
      rotation -0.57735 0.57735 0.57735 2.0944
      name "camera"
      fieldOfView 0.4646
      width 640
      height 480
    }
  ]
  toolSlot [
    Robotiq2f85Gripper {
    }
    TouchSensor {
      translation 0 0 0.14
      name "touch_sensor"
      boundingObject Sphere {
        radius 0.012
      }
      physics Physics {
        density -1
        mass 0.01
      }
    }
  ]
}
