# Universal Robots UR5e Articulated Arm (Supervisor dynamically spawns 12-piece batch)
CellUR5e {
  translation 0 0 0
  controller "cell_supervisor_conveyor_demo"
  supervisor TRUE
  baseSlot [
    Emitter {
      name "conveyor_cmd_emitter"
      channel 41
    }
    Receiver {
      name "conveyor_status_receiver"
      channel 42
    }
    Camera {
      translation 0 0.4 0.8
      rotation -0.57735 0.57735 0.57735 2.0944
      name "camera"
      fieldOfView 0.4646
      width 640
      height 480
    }
  ]
  toolSlot [
    DEF TOOL_MOUNT Pose {
      rotation 1 0 0 -1.5708
      children [
        Robotiq2f85Gripper {
        }
        DEF TOUCH_SENSOR TouchSensor {
          translation 0 0 0.100
          name "touch_sensor"
          boundingObject Box {
            size 0.01 0.01 0.002
          }
        }
      ]
    }
  ]
}
