WorldInfo {
  info [
    "Artisan Confectionery Full Conveyor Sorting Demo"
    "Module: Integrated Robotics 4 (TUS Athlone)"
    "Universal Robots UR5e + Robotiq 2F-85 + OpenCV Vision + Indexed Conveyor"
  ]
  title "Artisan Confectionery Full Conveyor Sorting Demo"
  basicTimeStep 16
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "ROBOTIQ gripper pad"
      material2 "default"
      coulombFriction [
        10.0
      ]
      bounce 0
      bounceVelocity 0.01
    }
  ]
}

Viewpoint {
  orientation -0.1945 0.300 0.9338 1.214
  position -0.60 -1.85 1.15
}

TexturedBackground {
}

TexturedBackgroundLight {
}

Floor {
  translation 0 0 -0.8
  size 6 6
  tileSize 1 1
}

# Main Industrial Pedestal Table (Top surface at Z = 0.0)
Solid {
  translation 0 0 -0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.4
        metalness 0.8
      }
      geometry Box {
        size 1.4 1.2 0.8
      }
    }
  ]
  name "cell_table"
  boundingObject Box {
    size 1.4 1.2 0.8
  }
}

# Upstream Conveyor Extension Support Bench (supports X in [-1.35, -0.70])
Solid {
  translation -1.025 0.40 -0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.58 0.62
        roughness 0.5
        metalness 0.7
      }
      geometry Box {
        size 0.65 0.24 0.8
      }
    }
  ]
  name "infeed_extension_bench"
  boundingObject Box {
    size 0.65 0.24 0.8
  }
}

# Indexed Hygienic Infeed Conveyor Belt (Spans X in [-1.30, +0.20], Y = 0.40, top Z = 0.040)
Robot {
  translation -0.55 0.40 0.0
  name "infeed_conveyor"
  controller "conveyor_controller"
  children [
    Emitter {
      name "conveyor_status_emitter"
      channel 42
    }
    Receiver {
      name "conveyor_cmd_receiver"
      channel 41
    }
    # Moving white food-grade belt track (top surface at Z = 0.040 m)
    Track {
      translation 0 0 0.030
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.96 0.96 0.96
            roughness 0.9
            metalness 0
            emissiveColor 0.88 0.88 0.88
          }
          geometry DEF BELT_BO Box {
            size 1.50 0.14 0.02
          }
        }
      ]
      boundingObject USE BELT_BO
      physics Physics {
        density -1
        mass 1
      }
      device [
        LinearMotor {
          name "belt_motor"
          acceleration -1
          maxVelocity 0.5
          sound ""
        }
      ]
    }
    # Static conveyor bed underneath belt
    Pose {
      translation 0 0 0.0095
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.25 0.28
            roughness 0.5
            metalness 0.6
          }
          geometry DEF CONVEYOR_BED Box {
            size 1.50 0.14 0.019
          }
        }
      ]
    }
    # Continuous side rails (top Z = 0.038 m, safely below belt surface & gripper plunge)
    Pose {
      translation 0 -0.078 0.019
      children [
        Shape {
          appearance DEF RAIL_APPEARANCE PBRAppearance {
            baseColor 0.20 0.23 0.27
            roughness 0.4
            metalness 0.8
          }
          geometry Box {
            size 1.50 0.014 0.038
          }
        }
      ]
    }
    Pose {
      translation 0 0.078 0.019
      children [
        Shape {
          appearance USE RAIL_APPEARANCE
          geometry Box {
            size 1.50 0.014 0.038
          }
        }
      ]
    }
    # Optical arrival photo-eye at X_world = +0.022 m, beam across +Y at Z = 0.050 m
    DistanceSensor {
      translation 0.572 -0.072 0.050
      rotation 0 0 1 1.5708
      name "arrival_sensor"
      type "laser"
      aperture 0.005
      numberOfRays 1
      lookupTable [
        0 0 0
        0.2 0.2 0
      ]
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.96 0.96 0.96
            roughness 0.8
            metalness 0
            emissiveColor 0.88 0.88 0.88
          }
          geometry Box {
            size 0.008 0.012 0.016
          }
        }
      ]
    }
  ]
  boundingObject USE CONVEYOR_BED
}

